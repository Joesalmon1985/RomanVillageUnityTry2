/Evidence/screenshots/
/Evidence/raw/

# Fast out-of-Unity test harness (DotNet/): keep projects and solution, ignore build output
!/DotNet/**/*.csproj
!/DotNet/*.sln
DotNet/**/bin/
DotNet/**/obj/
